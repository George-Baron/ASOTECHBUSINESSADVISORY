# Copy to .env.local in each app (apps/website, apps/inventory-app, apps/client-portal, apps/project-management).
# NEVER commit real values. Service-role and secret keys are server-only: do not prefix with NEXT_PUBLIC_.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key   # NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY also works
# Server only. Needed by: Paystack webhook, AppSheet intake route.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site URLs (used for links, sitemap, auth redirects) ---
NEXT_PUBLIC_WEBSITE_URL=https://www.asotech.com.ng
NEXT_PUBLIC_INVENTORY_URL=https://www.asotech.com.ng/inventory
NEXT_PUBLIC_PORTAL_URL=https://www.asotech.com.ng/portal
NEXT_PUBLIC_PM_URL=https://www.asotech.com.ng/staff

# --- Company contact details (confirm before launch) ---
NEXT_PUBLIC_CONTACT_EMAIL=info@asotech.com.ng
NEXT_PUBLIC_CONTACT_PHONE=+234 801 234 5678

# --- Paystack (only after the business account is approved) ---
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Spam protection for public forms (optional, Cloudflare Turnstile) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
