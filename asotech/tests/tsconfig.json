{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "types": ["node"],
    "typeRoots": ["/opt/npm-tools/node_modules/@types"]
  },
  "include": ["./unit/**/*.ts", "../packages/**/*.ts"]
}
